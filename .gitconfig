[color]
[color "branch"]
    current = yellow reverse
    local   = yellow
    remote  = green
[color "diff"]
	meta = 11
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
    added     = yellow
    changed   = green
    untracked = cyan

;Highlight whitespace in diffs

[color]
	ui = true
[color "diff"]
	whitespace = red reverse
	commit = yellow bold
[core]
    whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol

[user]
    name  = Javier López
    email = m@javier.io

[github]
    user = javier-lopez

[alias]
    d       = diff
    cm      = commit
    cmv     = commit -v
    s       = show
    st      = status
    br      = branch
    co      = checkout
    unstage = reset HEAD --
    last    = log -1 HEAD
    praise  = blame
    discart = checkout --
    glog    = log --all --pretty='format:%d %Cgreen%h%Creset %an - %s' --graph

[core]
    editor = vim
	pager = diff-so-fancy | less --tabs=4 -RFX

[merge]
    tool = vimdiff

[push]
	default = simple
[credential]
	helper = store
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[safe]
	directory = /home/m/tucastigo.com.bkp
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
