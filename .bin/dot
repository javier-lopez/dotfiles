#!/bin/sh
#description: git for the dotfiles repo, with $HOME as its work tree
#usage: dot [git command] [args]... | dot bootstrap [url] | dot get <path>...

#example: sh -c "$(curl -fsSL https://raw.githubusercontent.com/javier-lopez/dotfiles/master/.bin/dot)" dot bootstrap
#example: dot status
#example: dot add .claude/settings.json && dot commit -m "claude: allow jq"
#example: dot get /.vimrc

#refuses the commands whose blast radius is the whole home directory; the
#setup it expects is described in https://github.com/javier-lopez/dotfiles

DOT_DIR="${HOME}/.dotfiles.git"
DOT_URL="https://github.com/javier-lopez/dotfiles.git"
#the plugin manager the versioned .bashrc configures; overridable so the tests
#can point at a local repo and keep the network out of the suite
[ -z "${DOT_SHUNDLE_URL}" ] && DOT_SHUNDLE_URL="https://github.com/javier-lopez/shundle"

_usage() {
    printf "%s\\n" "Usage: ${PROGNAME} [git command] [args]..."
    printf "%s\\n" "       ${PROGNAME} bootstrap [url]"
    printf "%s\\n" "       ${PROGNAME} get <path>..."
    printf "%s\\n" "A wrapper around git for the dotfiles repo (~/.dotfiles.git), with \$HOME as"
    printf "%s\\n" "its work tree: every command but the ones below is passed through to git."
    printf "\\n"
    printf "%s\\n" "  bootstrap    clone the repo and set ~ up as its work tree, local files win;"
    printf "%s\\n" "               installs shundle when the .bashrc in ~ asks for it"
    printf "%s\\n" "  get          check one more tracked path out into ~"
    printf "%s\\n" "  -h, --help   show this help message and exit"
    printf "\\n"
    printf "%s\\n" "Refused: clean, add -A/--all/., reset --hard, checkout -f, switch -f,"
    printf "%s\\n" "switch --discard-changes and --autostash on pull, merge or rebase."
}

_die() {
    [ -z "${1}" ] || printf "%s\\n" "${*}" >&2
    _usage >&2; exit 1
}

_refuse() {
    printf "%s\\n" "${PROGNAME}: refused: ${*}" >&2
    exit 1
}

_git() {
    #run from $HOME: every cwd under ~ is inside the work tree, and git makes
    #ls-files output and pathspecs relative to it (an empty ls-files once built
    #an empty sparse pattern that dropped clean dotfiles). Paths are ~-relative.
    git -C "${HOME}" --git-dir="${DOT_DIR}" --work-tree="${HOME}" "${@}"
}

_bootstrap() {
    #overwrites nothing: a file that already exists under ~ keeps its content
    #and shows up in 'dot diff' as a change against the repo
    [ -f "${DOT_DIR}/index" ] && _refuse "'bootstrap' already ran" \
        "(${DOT_DIR}/index exists, a new reset would drop what is staged there)"

    #a run that died after the clone resumes from it
    [ -d "${DOT_DIR}" ] || git clone --bare "${1:-${DOT_URL}}" "${DOT_DIR}" || exit

    _git config core.bare false &&
    _git config status.showUntrackedFiles no &&
    _git config pull.ff only &&
    _git config rebase.autoStash false &&
    _git config merge.autoStash false &&
    _git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*' || exit

    branch="$(_git symbolic-ref --short HEAD)" || exit
    _git fetch -q origin && _git branch -q -u "origin/${branch}" "${branch}" || exit
    _git reset -q || exit #fills the index only, no file under ~ is touched

    #check out only what this machine already has, plus what every machine
    #gets. That second list is the repo's own, .dot/include, so adding a file
    #to every machine is a commit there and not a new version of this script.
    #It is read with 'show' because at this point nothing exists in the work
    #tree yet. The rest stays in the repo until 'dot get /<path>'
    always="$(_git show HEAD:.dot/include 2>/dev/null | sed \
        -e '/^[[:space:]]*#/d' -e 's/[[:space:]]*$//' -e 's|^/*||' -e '/^$/d')"

    #a repo without the file, or with an empty one, still has to bootstrap
    #into something that can go and get the rest: the ignore rules so the
    #home is not read as 157 untracked files, and this script so 'dot get'
    #exists. That is a floor, not a default - .dot/include lists them too
    [ -n "${always}" ] || always=".gitignore
.bin/dot"

    #the list becomes "$@": split on newlines alone so a tracked path with a
    #space in it survives, with globbing off so a '*' in it stays a literal.
    #$1 held the optional clone url, which the clone above already used
    IFS="
"; set -f; set -- ${always}; set +f; unset IFS

    { _git -c core.quotePath=false ls-files | while IFS= read -r file; do
          [ -e "${HOME}/${file}" ] && printf "/%s\\n" "${file}"
      done
      for file in "${@}"; do printf "/%s\\n" "${file}"; done
    } | _git sparse-checkout set --no-cone --stdin || exit

    for file in "${@}"; do
        [ -e "${HOME}/${file}" ] || _git checkout -- "${file}" || exit
    done

    printf "%s\\n" "${PROGNAME}: bootstrapped; M = local content kept, compare with: ~/.bin/dot diff"
    _git status --short
    _bootstrap_shundle
}

_bootstrap_shundle() {
    #the tracked .bashrc configures shundle, so the machine is only finished
    #once that plugin manager exists. But bootstrap keeps a local .bashrc, and
    #a machine that shipped its own has no 'Bundle=' line yet: installing then
    #would clone shundle to bring zero plugins, so say what is missing instead
    #always this home's own ~/.shundle: SHUNDLE_HOME is exported by shundle
    #itself, so honouring it would let the shell that runs bootstrap redirect
    #the install into another home
    _bootstrap_shundle__home="${HOME}/.shundle"

    if ! grep -q '^[^#]*Bundle=' "${HOME}/.bashrc" 2>/dev/null; then
        printf "%s\\n" "${PROGNAME}: no 'Bundle=' line in ~/.bashrc, so shundle was left alone"
        printf "%s\\n" "${PROGNAME}: to take the repo's one: ${PROGNAME} restore .bashrc && shundle install"
        return 0
    fi

    if [ ! -f "${_bootstrap_shundle__home}/bundle/shundle/shundle" ]; then
        git clone -q --depth=1 "${DOT_SHUNDLE_URL}" \
            "${_bootstrap_shundle__home}/bundle/shundle" || return 1
    fi

    #shundle reads the Bundle lines from the rc file SHUNDLE_RC names; without
    #it an installer running outside an interactive shell finds none
    SHUNDLE_RC="${HOME}/.bashrc" SHUNDLE_HOME="${_bootstrap_shundle__home}" \
        "${_bootstrap_shundle__home}/bundle/shundle/bin/shundle" install
}

_get() {
    #'sparse-checkout add' with the leading slash its patterns need: they are
    #gitignore patterns, so an unanchored '.vimrc' would also take '.vim/.vimrc'
    [ -z "${1}" ] && _die "'get' needs a path, e.g. '${PROGNAME} get /.vimrc'"

    _get__pending="${#}"
    while [ "${_get__pending}" -gt "0" ]; do
        case "${1}" in
            /*) set -- "${@}" "${1}"  ;;
             *) set -- "${@}" "/${1}" ;;
        esac
        shift
        _get__pending="$((_get__pending - 1))"
    done

    _git sparse-checkout add "${@}"
}

PROGNAME="${0##*/}"

[ "${#}" -eq "0" ] && _die

case "${1}" in
    -h|--help) _usage && exit ;;
    bootstrap) shift; _bootstrap "${@}"; exit ;;
    get)       shift; _get "${@}"; exit ;;
    clean) _refuse "'clean' deletes untracked files across \$HOME (ssh keys, non-repo dirs)" ;;
esac

for arg in "${@}"; do
    case "${1}:${arg}" in
        add:-A|add:--all|add:.)
            _refuse "'add ${arg}' stages every untracked dotfile; add explicit paths" ;;
        reset:--hard|checkout:-f|checkout:--force|switch:-f|switch:--force|switch:--discard-changes)
            _refuse "'${1} ${arg}' overwrites local dotfiles" ;;
        pull:--autostash|merge:--autostash|rebase:--autostash)
            _refuse "'--autostash' leaves conflict markers in live files" ;;
    esac
done

_git "${@}"

